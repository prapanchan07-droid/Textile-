# Copy to .env (git-ignored) and fill in. Used by docker-compose.yml.
POSTGRES_DB=textile
POSTGRES_USER=textile
# Required. Use a long random value, e.g.:  openssl rand -base64 24
POSTGRES_PASSWORD=admin
# Required. Signs login tokens, e.g.:  openssl rand -hex 32
SECRET_KEY=ashoktextiles
# production hides the demo logins and refuses to load demonstration data.
ENVIRONMENT=production
