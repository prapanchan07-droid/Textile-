# AI FACTORY MANAGER - Backend environment (copy to .env, which is git-ignored)
PROJECT_NAME="AI Factory Manager - Ashok Textiles"
COMPANY_NAME="Ashok Textiles"
VERSION="1.0.0"
ENVIRONMENT="development"   # production: no demo logins, no demo data
DEBUG=True

API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000

CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# --- Database (PostgreSQL). Set EITHER DATABASE_URL ...
# DATABASE_URL="postgresql+psycopg://textile:CHANGE_ME@localhost:5432/textile"
# ... OR the pieces (the app builds the URL and escapes the password for you):
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="textile"
POSTGRES_USER="textile"
POSTGRES_PASSWORD=""        # required

# Run `alembic upgrade head` when the API starts (development convenience). false in Docker.
AUTO_MIGRATE=true
# Mill-local time zone: decides where a production day starts.
MILL_TIMEZONE="Asia/Kolkata"

SECRET_KEY="change-me-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
SEED_DEMO_USERS=true        # ignored when ENVIRONMENT=production
LOG_LEVEL="INFO"

# Weaving platform
# UPLOAD_DIR="uploaded_reports"   # original report files, kept unmodified (default: backend/uploaded_reports)
MAX_UPLOAD_MB=25
BACKGROUND_JOBS_ENABLED=true      # telemetry polling + deadline/stale checks + escalation; true on ONE API process only
BACKGROUND_INTERVAL_SECONDS=60
TELEMETRY_STALE_SECONDS=300       # live data older than this is shown as STALE
TELEMETRY_RETENTION_DAYS=30
# Machine credentials are NEVER put here or in the database: set them on the collector host under the
# variable name configured per loom on the Connectivity page (e.g. TOYOTA_TMS_TOKEN).
